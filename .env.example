AWS_REGION="us-east-1"
environment="production"

# ─────────────────────────────────────────────────────────────────────────────
# Rede (opcional) — overrides das subnets/VPC usadas pelo Batch e pelo
# VPC endpoint do Secrets Manager. Se vazio, são descobertas automaticamente
# a partir do vpc_name definido em infra/tfvars/terraform.tfvars.
# SUBNET_IDS usa formato JSON (array), ex.: ["subnet-abc123","subnet-def456"]
# ─────────────────────────────────────────────────────────────────────────────
VPC_ID=""
SUBNET_IDS=""

# ─────────────────────────────────────────────────────────────────────────────
# Aurora PostgreSQL — Configuração de conexão
# Opção A: Preencha os valores diretamente (fallback se não usar Secrets Manager)
# Opção B: Defina DB_SECRET_NAME para buscar credenciais do Secrets Manager
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=""
DB_PORT=""
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# -----------------------------------------------------------------------------
# Secrets Manager (recomendado para produção)
# O Terraform cria automaticamente o segredo com o JSON abaixo:
#   { host, port, dbname, username, password }
# Caso já exista um segredo com este nome, ele é REUTILIZADO (não é recriado):
# o setup-env.sh faz o import para o estado do Terraform e o valor existente
# é preservado/adotado.
# -----------------------------------------------------------------------------
DB_SECRET_NAME="flight-radar-stream/aurora-credentials"