AWS_REGION="us-east-1"
environment="production"

# ─────────────────────────────────────────────────────────────────────────────
# Aurora PostgreSQL — Configuração de conexão
# Opção A: Preencha os valores diretamente (modo atual)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST="<aurora_endpoint>"
DB_PORT="5432"
DB_NAME="flightradar"
DB_USER="user_name"
DB_PASSWORD="<sua_senha>"

# ─────────────────────────────────────────────────────────────────────────────
# Opção B: Usar AWS Secrets Manager (recomendado para produção)
# O segredo deve conter JSON com: host, port, dbname, username, password
# O setup-env.sh buscará o segredo e exportará as variáveis TF_VAR_db_*
# ─────────────────────────────────────────────────────────────────────────────
# DB_SECRET_NAME="flight-radar-stream/aurora-credentials"
# DB_SECRET_ARN="arn:aws:secretsmanager:us-east-1:123456789012:secret:flight-radar-stream/aurora-credentials-xxxxx"
